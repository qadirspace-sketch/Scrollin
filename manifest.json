{
    "manifest_version": 3,
    "name": "Scrollin",
    "version": "3.0",
    "description": "Analyze, tag, and organize LinkedIn posts with AI. Get insights on hooks, topics, and creators to boost your content strategy.",
    "externally_connectable": {
        "matches": [
            "http://localhost/*"
        ]
    },
    "permissions": [
        "debugger",
        "storage",
        "tabs",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "*://www.linkedin.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://api.groq.com/*",
        "https://linkedin-post-tagger-worker.iamabdulsamad2-0.workers.dev/*",
        "http://localhost:5001/*"
    ],
    "background": {
        "service_worker": "dist/assets/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/*"
            ],
            "js": [
                "dist/assets/content.js"
            ],
            "css": [
                "dist/assets/content.css"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "dist/assets/*",
                "assets/*",
                "src/*"
            ],
            "matches": [
                "https://www.linkedin.com/*"
            ]
        }
    ]
}